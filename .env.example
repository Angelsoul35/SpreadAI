# SpreadAI configuration (prefix SA_)
SA_ENVIRONMENT=local
SA_CONFIDENCE_REVIEW_THRESHOLD=0.80   # below this, a spread goes to human review
SA_BALANCE_TOLERANCE=0.01             # allowed relative error in the accounting identity

# Credit-memo writing. "template" needs no LLM; "llm" uses the provider cascade.
SA_MEMO_MODE=template                 # template | llm
SA_LLM_PROVIDERS=anthropic,openai,gemini,deepseek,ollama
# Set keys only for the providers you use. Ollama is local and needs no key.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OLLAMA_HOST=http://localhost:11434
